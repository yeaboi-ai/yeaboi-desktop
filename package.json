{
  "name": "yeaboi-desktop",
  "//productName": "The display name everywhere: app.getName() in a dev run, CFBundleName and the installer filenames through electron-builder.",
  "productName": "yeaboi.ai",
  "//version": "The app's own semver, independent of the bundled yeaboi wheel. electron-updater compares it, so it must only ever go up: the last shared-version release was 3.32.0, which is why the independent line starts at 4.0.0. auto-version.yml bumps it on a release-worthy PR, together with the matching head entry in src/renderer/lib/yeaboi/shell-changelog.json; by hand, `node scripts/bump-version.mjs <level>` does the same — the release workflow refuses a mismatch.",
  "version": "4.2.0",
  "private": true,
  "description": "yeaboi desktop — the duck-branded planning app",
  "type": "module",
  "main": "out/main/index.js",
  "homepage": "https://yeaboi.ai",
  "license": "MIT",
  "author": {
    "name": "Omar Din",
    "//": "electron-builder requires an address for the deb maintainer field",
    "email": "64692956+dinho149@users.noreply.github.com"
  },
  "scripts": {
    "predev": "node scripts/dev-bundle-name.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:check": "node scripts/check-build.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "gen-manifest": "node scripts/gen-routes-manifest.mjs"
