{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],

    // Strictness matches the planning frontend the renderer came from —
    // its 95k lines were written under these flags, not the shell's old
    // stricter set.
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,

    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@design/*": ["./node_modules/@yeaboi-ai/design/design/*"],
      "next/navigation": ["./src/renderer/shims/next-navigation.ts"],
      "next/link": ["./src/renderer/shims/next-link.tsx"],
      "next/dynamic": ["./src/renderer/shims/next-dynamic.tsx"],
      "next-auth/react": ["./src/renderer/shims/next-auth.tsx"]
    },

    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "electron.vite.config.ts"]
}
