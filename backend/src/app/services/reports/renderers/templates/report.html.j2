<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ report.scope.label }} — Analytics report</title>
<style>
  @page { size: Letter; margin: 1in; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1a1a1a; font-size: 11pt; }
  h1 { font-size: 22pt; margin: 0 0 4pt; }
  h2 { font-size: 14pt; margin: 18pt 0 6pt; border-bottom: 1px solid #ddd; padding-bottom: 4pt; }
  .meta { color: #666; font-size: 10pt; margin-bottom: 12pt; }
  .estimated-banner {
    background: #fffbe6; border-left: 3px solid #d4a017;
    padding: 8pt 12pt; margin: 12pt 0; font-size: 10pt; color: #5c4500;
  }
  .total { font-size: 28pt; font-weight: 600; margin: 6pt 0; }
  table { width: 100%; border-collapse: collapse; font-size: 10pt; margin-top: 6pt; }
  th { text-align: left; background: #f4f4f4; padding: 6pt 8pt; font-weight: 600; }
  td { padding: 5pt 8pt; border-top: 1px solid #eee; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .center { text-align: center; }
  .est-mark { color: #d4a017; font-weight: 600; }
  .footer { margin-top: 24pt; color: #888; font-size: 9pt; }
  code { font-family: "SF Mono", Menlo, monospace; font-size: 9pt; background: #f4f4f4; padding: 1pt 4pt; border-radius: 3px; }
</style>
</head>
<body>
<h1>{{ report.scope.label }}</h1>
<div class="meta">
  Analytics report · <strong>{{ report.range.label() }}</strong>
  · Generated {{ report.generated_at.strftime('%b %-d, %Y %H:%M UTC') }}
  · {{ report.summary.total_sessions }} session{{ '' if report.summary.total_sessions == 1 else 's' }} in range
</div>

{% if report.is_partially_estimated %}
<div class="estimated-banner">
  <strong>⚠ Includes estimated values</strong> from historical back-fill —
  {{ report.summary.estimated_share_pct | round(0) | int }}% of total spend below
  is estimated rather than directly measured.
</div>
{% endif %}

<h2>Total spend</h2>
<div class="total">{{ report.total_cost_usd | usd }}</div>
<div class="meta">across {{ report.summary.providers }} provider{{ '' if report.summary.providers == 1 else 's' }}</div>

<h2>By provider</h2>
<table>
  <thead><tr><th>Provider</th><th class="num">Spend</th><th class="center">Estimated?</th></tr></thead>
  <tbody>
  {% for line in report.cost_lines %}
    <tr>
      <td>{{ line.provider }}</td>
      <td class="num">{{ line.cost_usd | usd }}</td>
      <td class="center">{% if line.is_estimated %}<span class="est-mark">⚠︎</span>{% else %}—{% endif %}</td>
    </tr>
  {% endfor %}
  {% if not report.cost_lines %}
    <tr><td colspan="3" class="center" style="color:#888;">no provider activity in range</td></tr>
  {% endif %}
  </tbody>
</table>

<h2>Top sessions</h2>
<table>
  <thead>
    <tr>
      <th>Session</th><th>Project</th><th>Started</th><th>Duration</th>
      <th class="num">Messages</th><th class="num">Cost</th>
    </tr>
  </thead>
  <tbody>
  {% for s in report.sessions %}
    <tr>
      <td><code>{{ s.session_id[:8] }}</code></td>
      <td>{{ s.project_name or '—' }}</td>
      <td>{{ s.started_at.strftime('%b %-d %H:%M') if s.started_at else '—' }}</td>
      <td>{{ ('%.1f min' % s.duration_minutes) if s.duration_minutes else '—' }}</td>
      <td class="num">{{ s.messages }}</td>
      <td class="num">{{ s.cost_usd | usd }}{% if s.is_estimated %} <span class="est-mark">⚠︎</span>{% endif %}</td>
    </tr>
  {% endfor %}
  {% if not report.sessions %}
    <tr><td colspan="6" class="center" style="color:#888;">no sessions in range</td></tr>
  {% endif %}
  </tbody>
</table>

<div class="footer">
Generated by Planning Platform analytics. Cost figures marked
<span class="est-mark">⚠︎</span> are estimated from session metadata.
</div>
</body>
</html>
