# yeaboi-desktop — main-process configuration. All optional in dev: the
# defaults match a stock planning-platform checkout running locally.

# Where the planning-platform FastAPI lives.
YEABOI_API_URL=http://localhost:8000

# MUST equal planning-platform's NEXTAUTH_SECRET — the desktop mints the same
# HS256 JWTs the platform's Next server did. The default matches
# planning-platform/.env.example so zero-config dev works.
YEABOI_JWT_SECRET=dev-secret-change-in-prod-please
YEABOI_REPO=/Users/neakoh/yeaboi-ai-main
